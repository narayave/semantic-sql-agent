# cp .env.example .env and fill this in, or just export it in your shell.
ANTHROPIC_API_KEY=sk-ant-...

# --- Snowflake (optional, see SNOWFLAKE.md) ---
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
# key-pair auth instead of a password:
# SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
